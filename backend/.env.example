# Server
NODE_ENV=development
PORT=4000

# Database (MongoDB Atlas replica set recommended for transactions)
# Include a database name in the path, e.g. .../edumin?ssl=true...
MONGO_URI=mongodb://localhost:27017/edumin

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# CORS: the frontend origin allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_MAX_MB=10

# Cloudinary (fill these in from your Cloudinary dashboard)
# Free accounts must enable "Allow delivery of PDF and ZIP files"
# in Settings -> Security for document downloads to work.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=edumin

# Seed admin account (used by: npm run seed)
SEED_ADMIN_EMAIL=admin1@edu.vn
SEED_ADMIN_PASSWORD=Admin@123
